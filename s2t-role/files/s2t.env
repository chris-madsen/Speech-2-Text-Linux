# S2T configuration (system-wide)
#
# Uncomment and adjust as needed.
#
# Language: "auto" (default), "ru", "en", ...
# S2T_LANG=auto
#
# Audio input: PipeWire node id or node name passed to `pw-record --target`.
# Find candidates with: `pw-cli ls Node | rg -n 'node.name|node.description'`
# S2T_AUDIO_TARGET=
#
# Model settings (Whisper.cpp ggml models)
# Preset: fast (tiny), balanced (small), medium (medium), accurate (large). Default: balanced.
# S2T_MODEL_PRESET=balanced
#
# For best accuracy, set the large model:
# S2T_MODEL_PATH=/home/ilja/.local/share/s2t/ggml-large-v3-turbo.bin
# S2T_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
#
# If S2T_MODEL_PATH is not set, S2T picks the best available model according to S2T_MODEL_PRESET.
#
# Performance tuning
# S2T_THREADS=5
# S2T_NO_SPEECH_THOLD=0.9
#
# Decode speed vs accuracy (defaults are fast)
# S2T_BEAM_SIZE=1
# S2T_BEST_OF=1
#
# Extra whisper-cli flags (advanced)
# Example (if supported by your build): S2T_WHISPER_ARGS="-fa"
# S2T_WHISPER_ARGS=

# Use long-running whisper-server to keep the model in memory (recommended)
# S2T_USE_SERVER=1
# S2T_WHISPER_SERVER_PORT=9787
# S2T_WHISPER_SERVER_URL=http://127.0.0.1:9787/inference

# Debug timings (logs durations into $XDG_RUNTIME_DIR/s2t/s2t.log)
# S2T_DEBUG_TIMING=0
#
# Log growth controls:
# - active runtime log rotation (default 1 MiB, keep 3 rotated files)
# S2T_LOG_MAX_BYTES=1048576
# S2T_LOG_KEEP=3
# - keep at most N failed whisper-cli artifacts in $XDG_RUNTIME_DIR/s2t
# S2T_WHISPER_ARTIFACT_KEEP=6
# - cap each failed whisper-cli stderr log size
# S2T_WHISPER_LOG_MAX_BYTES=524288

# ASR provider:
# - local (default): whisper.cpp running on your machine (no network)
# - google: send audio to Google Cloud Speech-to-Text (fast/accurate, but uses network + costs money)
# - google-v2: Google Speech-to-Text v2 (Chirp models; best quality, requires OAuth/ADC via gcloud)
# - openai: send audio to OpenAI for transcription (fast/accurate, but uses network + costs money)
# S2T_ASR_PROVIDER=local
#
# Strict network-only mode:
# - 1: never fall back to local whisper (no CPU/GPU fallback path)
# - 0: allow local fallback when cloud provider fails
# S2T_NETWORK_ONLY=0
#
# Hard response-time ceiling for cloud ASR timeouts (seconds).
# Individual cloud timeout vars are clamped to this value.
# Set 0 to disable cap completely.
# S2T_MAX_RESPONSE_SECONDS=0
#
# Google Cloud Speech-to-Text settings (when S2T_ASR_PROVIDER=google):
# Note: API key goes to ~/.config/s2t/secrets.env (0600).
# S2T_GOOGLE_MODEL=latest_short
# S2T_GOOGLE_LANGUAGE_CODE=ru-RU
# S2T_GOOGLE_ALT_LANGUAGE_CODES=en-US
# S2T_GOOGLE_CONNECT_TIMEOUT_SEC=3
# S2T_GOOGLE_ENABLE_PUNCTUATION=1
# S2T_GOOGLE_TIMEOUT_SEC=0
# S2T_GOOGLE_RETRY_ON_EMPTY=1
# When enabled, S2T retries v1 empty responses with the long model for short audio.
# If still empty and google-v2 credentials are configured, S2T retries via Chirp before local fallback.
# S2T_AVOID_LOOPBACK_SOURCE=1
# S2T_AUDIO_TARGET_EXCLUDE_RE="snd_aloop|loopback|monitor"
# S2T_ENABLE_ALSA_CAPTURE_FALLBACK=1
#
# Google Speech-to-Text v2 (Chirp) settings (when S2T_ASR_PROVIDER=google-v2):
# Note: v2 doesn't support API keys. Use OAuth/ADC (e.g. `gcloud auth application-default login`).
# S2T_GCP_PROJECT=
# S2T_GOOGLE_V2_LOCATION=global
# S2T_GOOGLE_V2_MODEL=chirp_2
# S2T_GOOGLE_V2_LANGUAGE_CODES=ru-RU,en-US
# S2T_GOOGLE_V2_ENABLE_PUNCTUATION=1
# S2T_GOOGLE_V2_TIMEOUT_SEC=5
# S2T_GOOGLE_V2_ON_EMPTY=1
#
# OpenAI transcription settings (when S2T_ASR_PROVIDER=openai):
# Note: DO NOT put API keys into /etc/s2t/s2t.env (it's world-readable by default).
# Put secrets into ~/.config/s2t/secrets.env instead (created by install).
# S2T_OPENAI_MODEL=gpt-4o-mini-transcribe
# S2T_OPENAI_TIMEOUT_SEC=0

# UI / insertion behavior
# Show desktop notifications (default: 0)
# S2T_NOTIFY=0
#
# How to insert the result into the focused app:
# - paste (default): copy to clipboard + paste keys (fast, works for Cyrillic)
# - type: emulate typing (can be slow for long text)
# - none: only saves last transcript to $XDG_RUNTIME_DIR/s2t/last_transcript.txt
# S2T_INSERT_METHOD=paste
#
# Paste shortcut to use:
# - S2T_PASTE_KEYS=auto (default): on X11, pick based on focused app:
#     - terminals: ctrl+shift+v (safe for tmux)
#     - editors/text fields: ctrl+v
#   - if focused app can't be detected, fallback is shift+insert
# - Or set a fixed value: shift+insert | ctrl+v | ctrl+shift+v
# S2T_PASTE_KEYS=auto
# S2T_PASTE_KEYS_FALLBACK=shift+insert
#
# If using type on X11: per-key delay (ms). Default: 0
# S2T_XDOTOOL_DELAY_MS=0
#
# Safety limit for recording length in seconds (0 = unlimited).
# Helps avoid "stuck recording" scenarios if key release event is missed.
# S2T_MAX_RECORD_SECONDS=5
#
# Preserve clipboard contents (default: 0). When enabled, S2T saves current clipboard,
# replaces it to paste transcript, then restores the previous clipboard.
# Note: this adds a tiny delay to avoid racing the target app paste.
# S2T_PRESERVE_CLIPBOARD=1
# S2T_PRESERVE_CLIPBOARD_STRICT=0
# S2T_CLIPBOARD_RESTORE_DELAY_MS=120
# S2T_LOG_VERBOSE=1
#
# Dataset collection and asynchronous ETL:
# submit corrected text via:
#   echo "corrected text" | s2t-controller submit-correction
# S2T_DATASET_ROOT=${XDG_DATA_HOME:-$HOME/.local/share}/s2t/dataset
# S2T_DATASET_RAW_DIR=
# S2T_DATASET_QUEUE_DIR=
# S2T_DATASET_OUTPUT_DIR=
# S2T_DATASET_ENQUEUE_CORRECTION=1
# S2T_DATASET_ETL_AUTORUN=1
# S2T_DATASET_ETL_INTERVAL_SEC=2
# S2T_DATASET_TEST_RATIO=0.1
# S2T_DATASET_JOBS=4
# S2T_DATASET_SEED=42
# S2T_DATASET_VALIDATE_PAIRS=1
# S2T_DATASET_VALIDATE_WITH_LLM=0
# S2T_DATASET_LLM_REQUIRED=0
# S2T_DATASET_LLM_VALIDATOR_CMD=
# S2T_DATASET_LLM_MODEL=
# S2T_DATASET_LLM_TIMEOUT_SEC=45
# S2T_DATASET_ASR_PROBE_ENABLED=1
# S2T_DATASET_ASR_PROBE_REQUIRED=0
# S2T_DATASET_ASR_PROBE_URL=
# S2T_DATASET_ASR_PROBE_TIMEOUT_SEC=15
# S2T_DATASET_QUARANTINE_MODE=copy
# S2T_DATASET_CLUSTER_ON_SUBMIT=1
# S2T_DATASET_MULTI_SEGMENT_GAP_SEC=20
# S2T_DATASET_MULTI_SEGMENT_MAX_COUNT=6
# S2T_DATASET_LOG_VERBOSE=1
# S2T_DATASET_LOG_FILE=
# S2T_DATASET_LOG_MAX_BYTES=2097152
# S2T_DATASET_LOG_KEEP=5
# S2T_QUEUE_BACKEND=rabbitmq
# S2T_RABBITMQ_URL=amqp://s2t:s2t@127.0.0.1:5672/%2F
# S2T_RABBITMQ_QUEUE=s2t.dataset.jobs
# S2T_RABBITMQ_EXCHANGE=
# S2T_RABBITMQ_ROUTING_KEY=s2t.dataset.jobs
# S2T_RABBITMQ_QUEUE_TYPE=classic
# S2T_RABBITMQ_PUBLISHER=/etc/s2t/scripts/rabbitmq_publish.py
# S2T_RABBITMQ_PUBLISH_RETRIES=2
# S2T_RABBITMQ_PUBLISH_RETRY_DELAY_MS=100
# S2T_RABBITMQ_SOCKET_TIMEOUT_SEC=1
# S2T_RABBITMQ_DRAIN_PREFETCH=20
# S2T_RABBITMQ_DRAIN_POLL_SEC=0.25
# S2T_RABBITMQ_DRAIN_RECONNECT_SEC=2
# S2T_RABBITMQ_DRAIN_LOG_VERBOSE=1
# S2T_RABBITMQ_DRAIN_LOG_FILE=
# S2T_RABBITMQ_DRAIN_LOG_MAX_BYTES=1048576
# S2T_RABBITMQ_DRAIN_LOG_KEEP=3
# S2T_PODMAN_BIN=
# S2T_RABBITMQ_IMAGE=docker.io/library/rabbitmq:3.13-management
# S2T_RABBITMQ_DEFAULT_USER=s2t
# S2T_RABBITMQ_DEFAULT_PASS=s2t
#
# Codex chat bridge:
# Automatically submits corrected chat text to pending audio in a strict time window.
# S2T_CODEX_BRIDGE_ENABLED=1
# S2T_CODEX_BRIDGE_WINDOW_SEC=30
# S2T_CODEX_BRIDGE_MAX_PENDING_AGE_SEC=600
# S2T_CODEX_BRIDGE_POLL_SEC=1
# S2T_CODEX_BRIDGE_MAX_MSG_CHARS=900
# S2T_CODEX_BRIDGE_MIN_SHARED_TOKENS=2
# S2T_CODEX_BRIDGE_MIN_TOKEN_OVERLAP=0.2
# S2T_CODEX_BRIDGE_SUBMIT_TIMEOUT_SEC=20
# S2T_CODEX_BRIDGE_BACKFILL_EXISTING=0
# S2T_CODEX_BRIDGE_LOG_VERBOSE=1
# S2T_CODEX_BRIDGE_LOG_FILE=
# S2T_CODEX_BRIDGE_LOG_MAX_BYTES=1048576
# S2T_CODEX_BRIDGE_LOG_KEEP=3

