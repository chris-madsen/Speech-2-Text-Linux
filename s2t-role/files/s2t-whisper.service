[Unit]
Description=S2T Whisper Server (User)
After=graphical-session.target
PartOf=s2t.target

[Service]
Type=simple
EnvironmentFile=/etc/s2t/s2t.env
EnvironmentFile=-%h/.config/s2t/secrets.env
EnvironmentFile=-%h/.config/s2t/s2t.env
ExecStart=/etc/s2t/scripts/whisper_server.sh
Restart=always
RestartSec=1
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
Nice=10
CPUQuota=500%
CPUWeight=25
MemoryHigh=2500M
MemoryMax=3G
TasksMax=64

[Install]
WantedBy=default.target
WantedBy=s2t.target
