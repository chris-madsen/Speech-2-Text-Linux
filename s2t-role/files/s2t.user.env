# User overrides for S2T (per-user, no sudo needed).
# This file is loaded by systemd user services:
#   - s2t-monitor.service
#   - s2t-whisper.service
#
# Example overrides:
# S2T_MODEL_PRESET=small
# S2T_PASTE_KEYS=auto
# S2T_PASTE_KEYS_FALLBACK=shift+insert
# S2T_MAX_RECORD_SECONDS=5
# S2T_DEBUG_TIMING=1
#
# To use Google transcription (cloud):
# S2T_ASR_PROVIDER=google
# S2T_GOOGLE_MODEL=latest_short
# S2T_GOOGLE_LANGUAGE_CODE=ru-RU
# S2T_NETWORK_ONLY=1
# S2T_MAX_RESPONSE_SECONDS=5
#
# To use Google Speech-to-Text v2 (Chirp; best quality, but needs OAuth/ADC via gcloud):
# S2T_ASR_PROVIDER=google-v2
# S2T_GOOGLE_V2_LOCATION=global
# S2T_GOOGLE_V2_MODEL=chirp_2
# S2T_GOOGLE_V2_LANGUAGE_CODES=ru-RU,en-US
# S2T_GCP_PROJECT=your-gcp-project-id
#
# To use OpenAI transcription (cloud):
# S2T_ASR_PROVIDER=openai
# S2T_OPENAI_MODEL=gpt-4o-mini-transcribe
