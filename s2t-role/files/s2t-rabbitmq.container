[Unit]
Description=S2T RabbitMQ (Rootless Podman)
PartOf=s2t.target
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/rabbitmq:3.13-management
ContainerName=s2t-rabbitmq
Pull=missing
PublishPort=127.0.0.1:5672:5672
PublishPort=127.0.0.1:15672:15672
Volume=%h/.local/share/s2t/rabbitmq/data:/var/lib/rabbitmq
Volume=%h/.local/share/s2t/rabbitmq/log:/var/log/rabbitmq
Environment=RABBITMQ_DEFAULT_USER=s2t
Environment=RABBITMQ_DEFAULT_PASS=s2t
PodmanArgs=--memory=500m
PodmanArgs=--pids-limit=256
PodmanArgs=--log-driver=journald

[Service]
Restart=always
RestartSec=3
TimeoutStartSec=180

[Install]
WantedBy=default.target
WantedBy=s2t.target
