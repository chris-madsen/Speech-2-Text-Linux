[Unit]
Description=Whisper Cloud Run keepalive daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/whisper-cloud-keepalive
ExecStart=/usr/local/bin/whisper-cloud-keepalive.sh
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
